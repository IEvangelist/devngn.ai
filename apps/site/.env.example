# Copy these names into the Netlify project environment for apps/site.
# For direct Astro development, you can also copy them into apps/site/.env.local.

# Optional: improves GitHub release metadata limits on the download page.
GITHUB_TOKEN=

# Required only for the authenticated vendor intelligence API.
# Format: key:subscription-level:account-id, with multiple entries comma-separated.
DEVNGN_VENDOR_API_KEYS=
